---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

// 英文正文页：只为有 index.en.md 的文章生成；date/tags 以中文条目为准（见 content.config.ts）
export async function getStaticPaths() {
  const [enPosts, zhPosts] = await Promise.all([getCollection('blogEn'), getCollection('blog')]);
  const zhById = new Map(zhPosts.map((p) => [p.id, p]));
  return enPosts.map((post) => ({
    params: { slug: post.id },
    props: { post, zh: zhById.get(post.id)! },
  }));
}

const { post, zh } = Astro.props;
const { Content } = await render(post);
const fmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' });
---

{/* translated 默认 true：hreflang 自动成对，语言切换与提示指向 /blog/<slug> 中文版 */}
<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="mx-auto max-w-[65ch] py-10">
    <header>
      <p class="text-sm text-neutral-500 dark:text-neutral-400">
        <time datetime={zh.data.date.toISOString().slice(0, 10)}>{fmt.format(zh.data.date)}</time>
      </p>
      <h1 class="mt-2 text-3xl font-bold leading-snug">{post.data.title}</h1>
      {
        zh.data.tags.length > 0 && (
          <p class="mt-4 flex flex-wrap gap-x-3 gap-y-1 text-xs text-neutral-500 dark:text-neutral-400">
            {zh.data.tags.map((tag) => (
              <span># {tag}</span>
            ))}
          </p>
        )
      }
    </header>

    <div class="prose prose-neutral mt-10 dark:prose-invert">
      <Content />
    </div>

    <footer class="mt-12 border-t border-neutral-200 pt-6 text-sm dark:border-neutral-800">
      <a href="/en/blog" class="text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100">
        ← All posts
      </a>
    </footer>
  </article>
</BaseLayout>
